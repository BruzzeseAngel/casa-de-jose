# Copia como .env, completa tus parámetros y reinicia npm run dev.
# Con true no se conecta a Firebase; el catálogo y las tarifas son ficticios.
# Con false se consultan habitaciones, servicios y tarifas en Firestore (SOLO LECTURA).
VITE_DEMO_MODE=true

# Valores de la configuración WEB de tu proyecto Firebase (no claves privadas de servidor).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# No incluyas claves de cuenta de servicio, API de correo ni secretos en VITE_*.
