# Demostración: true = interfaz con datos FICTICIOS sin conectar Firebase.
# Para conexión real cambiar a false y rellenar los seis valores siguientes.
VITE_DEMO_MODE=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional. Recomendado antes de publicar: App Check / reCAPTCHA Enterprise.
VITE_RECAPTCHA_SITE_KEY=
# Solo para depuración autorizada de App Check en localhost:
VITE_APPCHECK_DEBUG_TOKEN=

# Opcional: URL pública de una fotografía real del hostal para ponerla primera en portada.
# No incluyas credenciales ni URLs privadas.
VITE_HERO_IMAGE_URL=
