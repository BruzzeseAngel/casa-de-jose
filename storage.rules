rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // El permiso de escritura se comprueba en Storage mediante la claim del token autenticado.
    function admin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    match /habitaciones/{habitacionId}/{archivo} {
      // Las fotos del catálogo son públicas; nunca almacenar aquí documentos privados.
      allow read: if true;
      allow create, update: if admin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }
    match /servicios/{servicioId}/{archivo} {
      // Fotografías públicas para servicios y espacios comunes; sin datos privados.
      allow read: if true;
      allow create, update: if admin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }
    match /portada/{archivo} {
      // Imágenes generales del alojamiento; acceso público a lectura y sólo admin para cambios.
      allow read: if true;
      allow create, update: if admin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
